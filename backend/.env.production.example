# Production environment for cargo.playb.in (Hostinger).
# Copy this to `.env` ON THE SERVER (once), fill the real values, then run
# `php artisan key:generate`. This file is NOT overwritten by deploys.

APP_NAME="Transoria Online"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cargo.playb.in

# --- Database (create it in hPanel → Databases → MySQL) ---------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=uXXXXXXXX_transoria
DB_USERNAME=uXXXXXXXX_transoria
DB_PASSWORD=your-strong-password

# --- Caching / sessions / queues -------------------------------------------
# 'database' works out of the box on shared hosting (no Redis required).
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
SESSION_LIFETIME=120

LOG_CHANNEL=stack
LOG_LEVEL=error

# One-time browser installer token (visit /__setup?token=THIS_VALUE once, then
# remove this line). Use a long random string.
SETUP_TOKEN=

# Same-origin SPA, so no special Sanctum stateful domains are required for the
# token-based API. Set this only if you later add cookie-based SPA auth.
# SANCTUM_STATEFUL_DOMAINS=cargo.playb.in
